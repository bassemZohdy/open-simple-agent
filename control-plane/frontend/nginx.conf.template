server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Runtime configuration is generated by the image entrypoint from
    # OSA_API_BASE_URL. This keeps one released image usable in local Docker
    # and deployment-specific browser environments.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.__OSA_RUNTIME_CONFIG__ = { apiBaseUrl: "${OSA_API_BASE_URL}" };';
    }

    location = /health/live {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # React Router owns deep links. Static assets must still fail closed so a
    # typo cannot return the application shell with a successful asset status.
    location ~* \.(?:css|js|json|map|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
