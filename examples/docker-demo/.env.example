# Use matching tags from one OSA release. The defaults track the latest published images.
OSA_CONTROL_PLANE_IMAGE=ghcr.io/bassemzohdy/open-simple-agent-control-plane:latest
OSA_CONTROL_PANEL_IMAGE=ghcr.io/bassemzohdy/open-simple-agent-control-panel:latest

# These host ports are loopback-only and can be changed if occupied.
OSA_CONTROL_PLANE_PORT=8000
OSA_CONTROL_PANEL_PORT=8080
OSA_RUNTIME_PORT=8081
